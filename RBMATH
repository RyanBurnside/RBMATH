(RB.INTEGERNOISE
  [LAMBDA (N)                                                (* N IS EXPECTED TO BE AN INTEGER.
                                                             USED IN COHERENT NOISE FNS)
    (LET* ((M_N
            (LOGAND N 4294967295))
           (X (LOGAND (LOGXOR M_N
                             (LSH M_N
                                  13))
                     4294967295))
           (HASH (LOGAND (IPLUS 1376312589 (ITIMES X (IPLUS (ITIMES X (ITIMES X 15731))
                                                            789221)))
                        4294967295)))
          (FDIFFERENCE (FQUOTIENT (FLOAT HASH)
                              2.1474836E+9)
                 1.0])

(RB.INTERPOLATECOS
