         LARGER DELTAS BETWEEN X RESULT IN MORE NOISY NOISE)

    (LET* [(INT-X (FIX X))
           (N0 (RB.INTEGERNOISE INT-X))
           (N1 (RB.INTEGERNOISE (IPLUS INT-X 1)))
           (WEIGHT (FDIFFERENCE X (FIX X)))
