(RB.COHERENTNOISE
  [LAMBDA (X)

         (* GIVEN A FLOAT X, RETURN A POINT ALONG NOISE PRIMTIVE.
         LARGER DELTAS BETWEEN X RESULT IN MORE NOISY NOISE)

    (LET* [(INT-X (FIX X))
           (N0 (RB.INTEGERNOISE INT-X))
           (N1 (RB.INTEGERNOISE (IPLUS INT-X 1)))
           (WEIGHT (FDIFFERENCE X (FIX X)))
           (NOISE (RB.LERP N0 N1 (RB.SMOOTHSTEP 0.0 1.0 WEIGHT]
          NOISE])

(RB.DIST2D
  [LAMBDA (X Y X2 Y2)
    (LET ((A (FDIFFERENCE X2 X))
          (B (FDIFFERENCE Y2 Y)))
         (SQRT (FPLUS (FTIMES A A)
                      (FTIMES B B])

(RB.DIST3D
  [LAMBDA (X Y Z X2 Y2 Z2)
    (LET ((A (FDIFFERENCE X2 X))
          (B (FDIFFERENCE Y2 Y))
          (C (FDIFFERENCE Z2 Z)))
         (SQRT (FPLUS (FTIMES A A)
                      (FTIMES B B)
                      (FTIMES C C])

(RB.INTEGERNOISE
  [LAMBDA (N)                                                (* N IS EXPECTED TO BE AN INTEGER.
                                                             USED IN COHERENT NOISE FNS)
    (LET* ((M_N
            (LOGAND N 4294967295))
           (X (LOGAND (LOGXOR M_N
                             (LSH M_N
                                  13))
                     4294967295))
           (HASH (LOGAND (IPLUS 1376312589 (ITIMES X (IPLUS (ITIMES X (ITIMES X 15731))
                                                            789221)))
                        4294967295)))
          (FDIFFERENCE (FQUOTIENT (FLOAT HASH)
                              2.1474836E+9)
                 1.0])

(RB.INTERPOLATECOS
  [LAMBDA (A B W)                                            (* Use cosine interpolation between A 
                                                             and B with weight W.)
    (LET* ((W-CLAMPED (RB.CLAMP W 0.0 1.0))
           (FT (FTIMES W-CLAMPED CL:PI))
           (F (FTIMES (FDIFFERENCE 1.0 (COS FT))
                     0.5)))
          (FPLUS (FTIMES A (FDIFFERENCE 1.0 F))
                 (FTIMES B F])

(RB.INTERPOLATEEASEIN
  [LAMBDA (A B W)                                            (* Square the clamped weight directly 
                                                             to get the ease-in factor)
    (LET* ((W-CLAMPED (RB.CLAMP W 0.0 1.0))
           (F (FTIMES W-CLAMPED W-CLAMPED)))
          (FPLUS (FTIMES A (FDIFFERENCE 1.0 F))
                 (FTIMES B F])

(RB.INTERPOLATEEASEOUT
  [LAMBDA (A B W)
    (LET* [(W-CLAMPED (RB.CLAMP W 0.0 1.0))
           (INVERTED (FDIFFERENCE 1.0 W-CLAMPED))
           (F (FDIFFERENCE 1.0 (FTIMES INVERTED INVERTED]
          (FPLUS (FTIMES A (FDIFFERENCE 1.0 F))
                 (FTIMES B F])

(RB.ISOPLOT
  [LAMBDA (V3FLIST)
    (LET* ((W (CREATEW NIL "ISOMETRIC GRAPH"))
           (CENTERX (FTIMES (WINDOWPROP W 'WIDTH)
                           1/2))
           (CENTERY (FTIMES (WINDOWPROP W 'HEIGHT)
                           1/2))
           (SQRT2 (SQRT 2.0))
           (SQRT6 (SQRT 6.0)))
          (for V in V3FLIST do (with V3F V (LET ((XFIN (FQUOTIENT (FDIFFERENCE X Y)
                                                              SQRT2))
                                                 (YFIN (FQUOTIENT (FDIFFERENCE (FPLUS X Y)
                                                                         (FTIMES 2.0 Z))
                                                              SQRT6)))
                                                (DRAWCIRCLE (FPLUS CENTERX XFIN)
                                                       (FPLUS CENTERY YFIN)
                                                       2 NIL NIL W])

(RB.LERP
  [LAMBDA (A B W)
    (FPLUS (FTIMES A (FDIFFERENCE 1.0 W))
           (FTIMES B W])

(RB.NOISEGRAPH
  [LAMBDA (DATA)
    (LET* ((W (CREATEW))
           (WIDTH (WINDOWPROP W 'WIDTH))
           (HEIGHT (WINDOWPROP W 'HEIGHT))
           (STEP (FQUOTIENT WIDTH (LENGTH DATA)))
           (RADIUS 2)
           (HALF.HEIGHT (FTIMES HEIGHT 1/2))
           (SMALLEST (for I in DATA smallest I))
