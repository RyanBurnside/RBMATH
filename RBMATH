(RB.NOISEGRAPH
  [LAMBDA (DATA)
    (LET* ((W (CREATEW))
           (WIDTH (WINDOWPROP W 'WIDTH))
           (HEIGHT (WINDOWPROP W 'HEIGHT))
           (STEP (FQUOTIENT WIDTH (LENGTH DATA)))
           (RADIUS 2)
           (HALF.HEIGHT (FTIMES HEIGHT 1/2))
           (SMALLEST (for I in DATA smallest I))
           (LARGEST (for I in DATA largest I))
           (DELTA (FDIFFERENCE LARGEST SMALLEST)))
          (for D in DATA as I from 0 do (DRAWCIRCLE (FTIMES I STEP)
                                               (FPLUS (TIMES HALF.HEIGHT 1/2)
                                                      (FTIMES (FTIMES (FQUOTIENT (FDIFFERENCE D 
                                                                                        SMALLEST)
                                                                             DELTA)
                                                                     HEIGHT)
                                                             1/2))
                                               RADIUS NIL NIL W))
          (DRAWLINE 0 HALF.HEIGHT WIDTH HALF.HEIGHT 1 'INVERT W NIL '(1 3))
          W])

