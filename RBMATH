  [LAMBDA (V3FSTART V3FMIDDLE V3FEND PERCENT V3FOUT)        (* ; "Edited 17-Jun-2026 01:30 by ryan")
    (PROG (T1 T1-SQ T-SQ TWO-T1-T START-X START-Y START-Z MID-X MID-Y MID-Z END-X END-Y END-Z)
          (SETQ T1 (FDIFFERENCE 1.0 PERCENT))
          (SETQ T1-SQ (FTIMES T1 T1))
          (SETQ T-SQ (FTIMES PERCENT PERCENT))
          (SETQ TWO-T1-T (FTIMES 2.0 T1 PERCENT))
          (SETQ START-X (fetch (V3F X) of V3FSTART))
          (SETQ START-Y (fetch (V3F Y) of V3FSTART))
          (SETQ START-Z (fetch (V3F Z) of V3FSTART))
